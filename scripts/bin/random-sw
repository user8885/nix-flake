#!/bin/bash

# --- CONFIGURATION START ---

# 1. Path where you store all your wallpaper images (REQUIRED: Change this path!)
IMAGE_DIR="/home/user/Pictures/wallpapers/"

# 2. Your existing command to change the wallpaper (e.g., "sw")
WALLPAPER_COMMAND="sw"

# 3. Interval in seconds (15 minutes = 900 seconds)
INTERVAL=900

# --- CONFIGURATION  ---

echo "Starting Wallpaper Changer..."
echo "Will run every $((INTERVAL / 60)) minutes."

while true; do
    # Check if the image directory exists before proceeding
    if [ ! -d "$IMAGE_DIR" ]; then
        echo "[ERROR] Image directory not found: $IMAGE_DIR. Please update IMAGE_DIR in the script."
        exit 1
    fi

    # Select a random image file from the specified directory (assuming common formats)
    random_image=$(find "$IMAGE_DIR" -maxdepth 1 \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) | shuf -n 1)

    if [ -z "$random_image" ]; then
        echo "[WARNING] No image files found in $IMAGE_DIR. Waiting and skipping wallpaper change."
    else
        timestamp=$(date "+%Y-%m-%d %H:%M:%S")
        echo "[$timestamp] Changing wallpaper to: $(basename "$random_image")"

        # Execute the user's provided command (sw) with the random image path
        $WALLPAPER_COMMAND "$random_image"
    fi

    echo "Sleeping for $((INTERVAL / 60)) minutes..."
    sleep $INTERVAL
done
